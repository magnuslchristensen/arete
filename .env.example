# Copy to .env and fill in your values before running locally.

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml db service):
DATABASE_URL="postgresql://arete:arete_dev@localhost:5432/arete"

# Test DB (matches docker-compose.yml db_test service):
TEST_DATABASE_URL="postgresql://arete:arete_test@localhost:5433/arete_test"

# ─── Credentials ─────────────────────────────────────────────────────────────
# 32-byte hex key for Credential.ciphertext AES-256 encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY="<replace-with-32-byte-hex-key>"
